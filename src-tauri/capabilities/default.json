{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the Fangcun main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "dialog:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-temp-read",
    "fs:allow-write-file",
    "fs:allow-remove",
    "fs:allow-app-write",
    "opener:default"
  ]
}
